PORT=8080
NODE_ENV=development
PROJECT_NAME=AtomicTasks
MONGO_URI=mongodb://127.0.0.1:27017
# NODE_ENV selects atomictask_dev, atomictask_stage, or atomictask_prod.
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:8080

# Generate three distinct values with: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=30d
COOKIE_SAME_SITE=lax

# OAuth providers (optional; configure API_URL/api/auth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP is required for registration, password reset, and email verification
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
